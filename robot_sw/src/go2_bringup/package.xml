<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_bringup</name>
  <version>0.3.0</version>
  <description>
    Bringup for the Unitree Go2 patrol SUT (cv-infra consumer fixture): launch files
    and Nav2 parameters. Install-only — this package compiles nothing, it composes
    reused upstream assets (nav2_bringup launch + stock Nav2 params) and this repo's
    own perception/mission nodes.
  </description>
  <maintainer email="yjshin@etri.re.kr">CV-User team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <!-- go2_patrol.launch.py composes these three (U3). They are exec-only deps: this
       package still compiles nothing. -->
  <exec_depend>go2_detector</exec_depend>
  <exec_depend>go2_target_tracker</exec_depend>
  <exec_depend>go2_patrol_manager</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
