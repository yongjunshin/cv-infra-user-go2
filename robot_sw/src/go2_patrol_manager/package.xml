<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_patrol_manager</name>
  <version>0.4.0</version>
  <description>
    Patrol mission state machine. Serves go2_msgs/action/Patrol at /patrol and drives
    nav2 through its standard /navigate_to_pose: search the route, approach the confirmed
    target, hold it on screen, report where it was found.
  </description>
  <maintainer email="yongjun9461@gmail.com">yongjunshin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>go2_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
