# verify/space.pict — the input space, in Microsoft PICT's own syntax.
#
# cv-infra expands this into a covering array and runs one case per row, inside
# the wallclock budget the request declares. It reads the axes as names and
# values; what any of them MEAN is ours.
#
# Bind an axis to a field in the request document with `{param: <name>}`. Every
# axis must be bound by exactly one field and every bound name must appear here —
# an axis nothing reads is rejected rather than silently held constant.
#
# This six-axis space has 2 * 3 * 3 * 3 * 2 * 2 = 216 combinations. PICT pairwise
# coverage currently emits 12 cases; the reusable workflow can truncate the prefix
# when a caller supplies a smaller local budget, while the CI budget is sized for the
# complete array. Case identity is derived from these values, so changing an axis is
# an intentional baseline change.

target:      person, chair
start_x:     -6.3, -6.0, -5.7
start_y:     -1.3, -1.0, -0.7
start_yaw:   1.4208, 1.5708, 1.7208
box_count:   0, 1, 2
desk_count:  0, 1

# A chair only reads as `chair` from the front (0.834 front / 0 behind), so its
# bearing is pinned; a standing person reads from every angle measured.
IF [target] = "chair" THEN [start_yaw] = 1.5708;
