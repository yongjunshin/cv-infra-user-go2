# verify/space.pict — go2 "find what you are asked for, and only that", in PICT syntax.
#
# One row = one case. Every axis is a flag of verify/sim.py (`--name=value`, text) and the
# harness owns what the values MEAN. cv-infra expands this with PICT (k=2), runs the harness
# once per row inside verify/Dockerfile's image, collects verify/out/ (including the two
# top-view pictures), and reads verify/oracle.py's flat JSON by TYPE. PICT reads a trailing
# `# …` on a value line as part of the value, so every comment sits on its own line.
#
# THE LAYOUT (map frame = world frame, metres; see verify/sim.py):
#
#   H3 (-5, 10)                    H4 (3, 13)
#                 decoy spot (0, 8.5)
#                                        H2 (4, 6)
#        H1 (-3, 4)
#   desk a (-6, 3)       desk b (2, 3)            (each 2.8 m wide when present)
#   S1 (-6, -1)          S2 (0, 1.5)         S3 (6, 0)        facing +y
#
# The robot is asked for ONE class and is never told where anything is.
#
# CASE IDENTITY is a hash of a row's own assignment: a baseline follows a case across
# commits only as long as its values are untouched.

start:   S1, S2, S3

# The class the /patrol goal names.
target:  chair, person

# Where an object of THAT class stands — or `none`: it is not in the warehouse.
hide:    H1, H2, H3, H4, none

# An object of the OTHER class at the decoy spot, or nothing.
decoy:   none, present

# Obstacles: a desk across the floor, or nothing.
slot_a:  empty, desk
slot_b:  empty, desk
