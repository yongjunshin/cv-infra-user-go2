# Copy this file to `.env` and fill in the two consents YOURSELF — they are personal
# acts of agreement, which is why `.env` is gitignored and this repo ships no values.
#
#   cp .env.example .env
#
# ACCEPT_EULA: the NVIDIA Isaac Sim EULA (https://docs.isaacsim.omniverse.nvidia.com).
#   The sim container refuses to boot without it.
# PRIVACY_CONSENT: Omniverse telemetry consent prompt, same story.
#
# Set each to Y only if you, personally, agree.
ACCEPT_EULA=
PRIVACY_CONSENT=
