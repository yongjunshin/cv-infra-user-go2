# ROS 2 colcon build artifacts
build/
install/
log/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Local secrets / consents. `.env` carries the Isaac Sim EULA + privacy consent the
# OWNER of this machine gives personally — consent is a per-person act, so the file
# is never committed. Copy `.env.example` and fill it in yourself.
.env

# NOTE: model weights are deliberately NOT ignored. The locomotion policy
# (robot_sw/models/locomotion/policy.pt) is a versioned artifact of this robot —
# retraining replaces the file and its policy_meta.yaml together, and the diff
# should be visible. yolo11n is not committed either way — it is fetched by digest
# at image build time.
